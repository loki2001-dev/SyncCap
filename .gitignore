# build output
/build*/
/out/
compile_commands.json

# runtime output
/recordings/
/logs/
/logs-server/
/e2e_output/
*.log

# generated simulation inputs (scripts/make_samples.py); the sensor CSV is committed
/samples/video/
*.mp4
*.avi
*.h264

# FFmpeg + libx264 binaries are downloaded by scripts/fetch_ffmpeg.ps1, never committed
/3rdparty/ffmpeg_x264/
# third-party archives: only extracted source trees are committed
/3rdparty/**/*.zip
/3rdparty/**/*.tar.gz

# python
__pycache__/
*.py[cod]

# editors and OS
.idea/
.vs/
.DS_Store
Thumbs.db
